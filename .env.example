# ─────────────────────────────────────────────────────────────────────────
# Agentry — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────

# ── Model provider ───────────────────────────────────────────────────────────
# "gemini" (default), "bedrock-mantle", or "groq". Only one is active per run.
MODEL_PROVIDER=gemini

# ── Gemini (used when MODEL_PROVIDER=gemini) ────────────────────────────────
GEMINI_API_KEY=

# ── Groq (used when MODEL_PROVIDER=groq) ────────────────────────────────────
# Groq's API is OpenAI-Chat-Completions-compatible, so it runs through the
# same Strands OpenAIModel as Bedrock Mantle — just a plain API key and
# Groq's own base URL, no token-minting involved. Get a key at
# console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── AWS Bedrock via the OpenAI-compatible "Mantle" endpoint
#    (used when MODEL_PROVIDER=bedrock-mantle) ─────────────────────────────
# Reaches Bedrock models not on the native Converse API yet (e.g. the
# openai.gpt-oss-* line) through Strands' OpenAIModel. No API key to paste
# in yourself — Strands mints a fresh, short-lived bearer token per request,
# which needs real IAM credentials below (not just any AWS login) to sign.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Add AWS_SESSION_TOKEN= too if these are temporary credentials. A named
# profile or an IAM role picked up by boto3's normal credential chain also
# works, in place of the two keys above.

AWS_REGION=us-east-1
MANTLE_MODEL_ID=openai.gpt-oss-120b

# ── Telegram (notify_user tool) ────────────────────────────────────────────
# Create a bot via @BotFather on Telegram -> /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Storefront login ────────────────────────────────────────────────────────
# No env var needed here — log in once via `python scripts/capture_session.py`
# (opens a real browser window for you to log into manually) and every
# storefront tool reuses that saved session automatically. See README.

# ── Budget cap (check_budget tool) ──────────────────────────────────────────
# Weekly grocery spend cap, in the storefront's currency (e.g. INR).
# Defaults to 1500 if unset.
WEEKLY_BUDGET_INR=1500

# ── Voice mode (optional — POST /api/voice, the console's mic button) ──────
# Local Whisper size for speech-to-text: tiny | base | small | medium.
# Bigger is more accurate and slower; "base" is a fine default on a laptop.
VOICE_STT_MODEL=base
# Text-to-speech engine: auto | piper | coqui | say | espeak.
# "auto" uses piper if it's configured, else a built-in platform fallback
# (macOS `say` / espeak) so the loop works with nothing installed.
VOICE_TTS=auto
# For VOICE_TTS=piper — path to a downloaded piper voice (.onnx). Set
# PIPER_BIN too if the piper binary isn't on your PATH.
PIPER_VOICE=
# PIPER_BIN=piper
# For VOICE_TTS=coqui — a Coqui model id, and a speaker for multi-speaker
# models. Defaults to tts_models/en/vctk/vits.
# COQUI_MODEL=tts_models/en/vctk/vits
# COQUI_SPEAKER=p236

# ── Token usage (both providers) ────────────────────────────────────────────
# How many recent messages to keep in the conversation sent to the model —
# older tool results get truncated (not dropped) rather than resending the
# whole chat history in full on every turn. Defaults to 30 if unset. Lower
# it for a chattier/cheaper session, raise it if the agent seems to forget
# something from earlier in a long conversation.
CONVERSATION_WINDOW_SIZE=30
