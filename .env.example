# ─────────────────────────────────────────────────────────────────────────
# Agentry — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────

# ── Model (Gemini, via Strands' GeminiModel) ───────────────────────────────
GEMINI_API_KEY=

# ── Telegram (notify_user tool) ────────────────────────────────────────────
# Create a bot via @BotFather on Telegram -> /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Storefront login (browser_automation tool) ─────────────────────────────
# Indian mobile number registered on the storefront, without the +91 prefix.
ZEPTO_PHONE=
